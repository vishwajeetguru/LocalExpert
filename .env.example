# SevaSathi mobile app — API configuration (no secrets here, ever).
# Auth uses per-user X-Seva-Token issued by the plugin; nothing sensitive is stored.

# --- Environment switch -----------------------------------------------
# staging    → your LocalWP site (Live Link below). Use for development.
# production → your live hosted site. Use for release builds.
EXPO_PUBLIC_APP_ENV=staging

# --- Staging (LocalWP Live Link — enable it in the Local app first) ----
EXPO_PUBLIC_API_URL_STAGING=https://tall-support.localsite.io/wp-json/sevasathi/v1
# Live Links are password-protected: the app sends these as an HTTP Basic
# header ONLY to the staging host. Never reuse them anywhere else.
EXPO_PUBLIC_TUNNEL_USER=statue
EXPO_PUBLIC_TUNNEL_PASS=squeamish

# --- Production (live site — fill in at launch) -------------------------
EXPO_PUBLIC_API_URL_PRODUCTION=https://your-live-site.com/wp-json/sevasathi/v1

# --- Backend selector ---------------------------------------------------
# wordpress → live plugin data (default). mock → offline Shegaon demo.
EXPO_PUBLIC_API_MODE=wordpress

# --- Device / emulator notes -------------------------------------------
# iOS simulator + web on the same machine: staging URL works as-is.
# Android emulator cannot resolve .local hosts — but the Live Link IS a
# public https URL, so staging works on emulator + physical devices too
# (same thing that makes Live Link shippable for client demos).
# Physical devices just need internet access; no LAN tricks required.

# --- Offline demo fallback ----------------------------------------------
# EXPO_PUBLIC_API_MODE=mock
